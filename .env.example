# Copy to `.env` and adjust. Real env vars always win over this file.
TARGET_URL=https://example.com
HEADLESS=true
PAGE_TIMEOUT_S=30
VIEWPORT_W=1366
VIEWPORT_H=768
OUTPUT_DIR=output
# Optional:
# USER_AGENT=
# BROWSER_BIN=/usr/bin/google-chrome

# --- Optional proxy (off by default) ---
# PROXY_ENABLED=false
# Single static proxy:
# PROXY_URL=http://user:pass@host:port
# Rotating file pool (one URL per line, see proxies.example.txt):
# PROXY_FILE=proxies.txt
# Supabase-backed pool (same tech as legacy proxy_rotator.py):
# SUPABASE_URL=
# SUPABASE_KEY=
# SUPABASE_SECRET=
# PROXY_TABLE=proxy_results
# PROXY_TIER=premium
# PROXY_CHECK_URL=https://example.com
